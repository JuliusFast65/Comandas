DATABASE_URL=postgresql://comandas:change-this-database-password@127.0.0.1:5432/comandas
POSTGRES_USER=comandas
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=comandas
PORT=3000
HOST=0.0.0.0
# Change before creating the initial accounts. Required by db:init.
SEED_PASSWORD=change-this-user-password
# Set true behind HTTPS in production.
COOKIE_SECURE=false
# Set to the browser-visible origin, especially behind a reverse proxy.
APP_ORIGIN=http://localhost:3000
